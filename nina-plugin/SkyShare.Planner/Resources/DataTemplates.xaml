<ResourceDictionary
    x:Class="SkyShare.Planner.Resources.DataTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SkyShare.Planner.Sequencer"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer">

    <!--
      Sequencer views for the plugin's instructions.

      The two containers (SkyShareTargets, SkyShareFlats) derive from SequentialContainer.
      WPF resolves implicit DataTemplates up the type hierarchy, so they reuse NINA's
      built-in Sequential Instruction Set view - no template needed here. Their settings
      live on Load Plan, so the containers don't need a custom view.
      VERIFY on first load: if they render blank, copy NINA's SequentialContainer
      DataTemplate (or Target Scheduler's container template) and add it below.
    -->

    <DataTemplate DataType="{x:Type local:LoadPlan}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Plans folder" />
                        <TextBox MinWidth="320" Margin="6,0,0,0" VerticalAlignment="Center"
                                 Text="{Binding PlansDirectory}" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Night rolls over at" />
                        <TextBox MinWidth="30" Margin="6,0,0,0" VerticalAlignment="Center"
                                 Text="{Binding RolloverHour}" />
                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="h" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Wait for sync" />
                        <TextBox MinWidth="30" Margin="6,0,0,0" VerticalAlignment="Center"
                                 Text="{Binding WaitForPlanMinutes}" />
                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="min" />
                    </StackPanel>
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Targets: stop below" />
                        <TextBox MinWidth="30" Margin="6,0,0,0" VerticalAlignment="Center"
                                 Text="{Binding MinAltitude}" />
                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="° altitude" />
                        <CheckBox Margin="12,0,0,0" VerticalAlignment="Center" Content="Autofocus at start"
                                  IsChecked="{Binding AutofocusAtStart}" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Dither every" />
                        <TextBox MinWidth="30" Margin="6,0,0,0" VerticalAlignment="Center"
                                 Text="{Binding DitherEvery}"
                                 ToolTip="Fixed-count targets only. Cycle targets always dither once per cycle." />
                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="frames (fixed-count targets; 0 = off)" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Center drift threshold" />
                        <TextBox MinWidth="30" Margin="6,0,0,0" VerticalAlignment="Center"
                                 Text="{Binding CenterDriftThreshold}"
                                 ToolTip="Center After Drift on every target: re-center when the target has drifted more than this." />
                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="arcmin" />
                    </StackPanel>
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal"
                                ToolTip="Clear-sky estimate of tonight, posted to Discord with an altitude chart. These overheads only affect the estimate.">
                        <CheckBox VerticalAlignment="Center" Content="Night preview" IsChecked="{Binding SendNightPreview}" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="overheads: slew/center" />
                        <TextBox MinWidth="30" Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding SlewCenterMinutes}" />
                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="min, autofocus" />
                        <TextBox MinWidth="30" Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding AutofocusMinutes}" />
                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="min every" />
                        <TextBox MinWidth="30" Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding AutofocusEveryMinutes}"
                                 ToolTip="How often your template's autofocus triggers fire on average. 0 = only at the start of each target." />
                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="min, dither" />
                        <TextBox MinWidth="30" Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding DitherSeconds}" />
                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="s, per frame" />
                        <TextBox MinWidth="30" Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding FrameOverheadSeconds}" />
                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="s, meridian flip" />
                        <TextBox MinWidth="30" Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding MeridianFlipMinutes}" />
                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="min" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap"
                               Text="{Binding LoadedSummary}" />
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:RecordRotation}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <TextBlock VerticalAlignment="Center" Opacity="0.7"
                           Text="Remembers rotator position for this target's flats" />
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:TargetLimits}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <TextBlock VerticalAlignment="Center" Text="{Binding Summary}" />
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:SessionComplete}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Opacity="0.7"
                               Text="Writes the session manifest for SkyStack " />
                    <TextBlock VerticalAlignment="Center" Text="{Binding LastManifest}" />
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

