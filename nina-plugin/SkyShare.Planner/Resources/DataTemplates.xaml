<ResourceDictionary
    x:Class="SkyShare.Planner.Resources.DataTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SkyShare.Planner.Sequencer"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer">

    <!--
      Sequencer views for the plugin's instructions.

      The two containers (SkyShareTargets, SkyShareFlats) derive from SequentialContainer.
      WPF resolves implicit DataTemplates up the type hierarchy, so they reuse NINA's
      built-in Sequential Instruction Set view - no template needed here. Their settings
      are on the plugin's options page, so the containers don't need a custom view.
      VERIFY on first load: if they render blank, copy NINA's SequentialContainer
      DataTemplate (or Target Scheduler's container template) and add it below.
    -->

    <DataTemplate DataType="{x:Type local:LoadPlan}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Opacity="0.7" Text="Plans from " />
                        <TextBlock VerticalAlignment="Center" Text="{Binding Settings.PlansDirectory}" />
                        <TextBlock VerticalAlignment="Center" Opacity="0.7"
                                   Text="  (settings: Options &gt; Plugins &gt; SkyShare Planner)" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap"
                               Text="{Binding LoadedSummary}" />
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:RecordRotation}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <TextBlock VerticalAlignment="Center" Opacity="0.7"
                           Text="Remembers rotator position for this target's flats" />
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:TargetLimits}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <TextBlock VerticalAlignment="Center" Text="{Binding Summary}" />
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:SessionComplete}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Opacity="0.7"
                               Text="Writes the session manifest for SkyStack " />
                    <TextBlock VerticalAlignment="Center" Text="{Binding LastManifest}" />
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:SchedulerPreview}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Opacity="0.7"
                                   Text="Posts Target Scheduler's plan preview to Discord. Also save chart to" />
                        <TextBox MinWidth="260" Margin="6,0,0,0" VerticalAlignment="Center"
                                 Text="{Binding SaveFolder}" ToolTip="Optional folder for the chart PNG. Empty = Discord only." />
                        <CheckBox Margin="12,0,0,0" VerticalAlignment="Center" Content="Framing preview" IsChecked="{Binding SendFramingPreview}"
                                  ToolTip="Attach a sky-survey cutout of each scheduled target with the camera frame drawn at its rotation." />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap" Text="{Binding LastSummary}" />
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <!--
      SkyShareAstro Session is a SequentialContainer, so it uses NINA's own container view;
      its Mode text shows in the NINA log and Discord rather than in the view.
    -->

    <DataTemplate DataType="{x:Type local:SetTemperature}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox VerticalAlignment="Center" Content="Use the plan's temperature" IsChecked="{Binding UsePlanTemperature}"
                                  ToolTip="Use camera_temperature from tonight's plan when it has one; otherwise the fallback." />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Fallback" />
                        <TextBox MinWidth="40" Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding Temperature}"
                                 ToolTip="Set point when the plan gives none (default 0 °C)." />
                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="&#176;C" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Min Duration" />
                        <TextBox MinWidth="30" Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding RampMinutes}"
                                 ToolTip="Take at least this long to reach the set point. 0 = straight to the set point." />
                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="min" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding PlanInfo}" />
                    <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap" Text="{Binding LastResult}" />
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:SkyShareHealthCheck}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox VerticalAlignment="Center" Content="Stop on failure" IsChecked="{Binding StopOnFailure}"
                                  ToolTip="Fail this instruction when any check is FAIL, so the sequence's error behaviour applies." />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.7"
                                   Text="Thresholds: Options &gt; Plugins &gt; SkyShare Planner" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap" Text="{Binding LastResult}" />
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <!--
      Options > Plugins > SkyShare Planner. NINA finds this by key ("<plugin name>_Options")
      and sets its DataContext to the plugin (SkySharePlannerPlugin). Values are stored in
      the active NINA profile and apply to every sequence.
    -->
    <DataTemplate x:Key="SkyShare Planner_Options">
        <StackPanel Orientation="Vertical" Margin="0,0,0,10">
            <StackPanel.Resources>
                <!-- Theme text colour: NINA's PrimaryBrush follows the chosen colour schema (light/dark/red) -->
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                </Style>
                <Style x:Key="Head" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Margin" Value="0,14,0,4" />
                </Style>
                <Style x:Key="Lbl" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                    <Setter Property="Width" Value="230" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style x:Key="Unit" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                    <Setter Property="Margin" Value="6,0,0,0" />
                    <Setter Property="Opacity" Value="0.7" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style x:Key="Row" TargetType="StackPanel">
                    <Setter Property="Orientation" Value="Horizontal" />
                    <Setter Property="Margin" Value="0,2,0,2" />
                </Style>
            </StackPanel.Resources>

            <!-- Shown only while a newer version waits in NINA's staging folder -->
            <Border Margin="0,0,0,10" Padding="10,6" CornerRadius="3" BorderThickness="1"
                    BorderBrush="#FFB74D" Background="#33FFB74D">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Update.IsPending}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="12,0,0,0" Padding="12,3" VerticalAlignment="Center"
                            Command="{Binding RestartCommand}" Content="Restart N.I.N.A." />
                    <StackPanel Orientation="Vertical">
                        <TextBlock FontWeight="SemiBold" Text="Update ready: restart N.I.N.A. to load it" />
                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding Update.Message}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Shown when GitHub has a newer release that isn't installed yet -->
            <Border Margin="0,0,0,10" Padding="10,6" CornerRadius="3" BorderThickness="1"
                    BorderBrush="#64B5F6" Background="#3364B5F6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Updates.IsAvailable}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Margin="12,0,0,0" Padding="12,3" Command="{Binding OpenReleaseCommand}" Content="Release notes" />
                        <Button Margin="8,0,0,0" Padding="12,3" Command="{Binding InstallUpdateCommand}" Content="Install update" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical">
                        <TextBlock FontWeight="SemiBold" Text="Update available" />
                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding Updates.Message}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Opacity="0.7" VerticalAlignment="Center">
                    <Run Text="SkyShare Planner" />
                    <Run Text="{Binding Update.RunningVersion, Mode=OneWay}" />
                </TextBlock>
                <Button Margin="12,0,0,0" Padding="10,2" Command="{Binding RestartCommand}" Content="Restart N.I.N.A."
                        ToolTip="Restart N.I.N.A., for example after installing an update. Not available while a sequence runs." />
                <Button Margin="8,0,0,0" Padding="10,2" Command="{Binding CheckUpdatesCommand}" Content="Check for updates" />
                <CheckBox Margin="12,0,0,0" VerticalAlignment="Center" IsChecked="{Binding Settings.CheckForUpdates}"
                          Content="automatically" ToolTip="Look on GitHub after N.I.N.A. starts and every 12 hours. Nothing is installed without a click." />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.7" Text="{Binding Updates.Status}" />
            </StackPanel>
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="These apply to every sequence and are saved in the active NINA profile. Instructions read them when they run, so a change here needs no sequence edit." />

            <!-- ===== health check ===== -->
            <TextBlock Style="{StaticResource Head}" Text="Health check" />
            <StackPanel Style="{StaticResource Row}">
                <Button Command="{Binding RunHealthCheckCommand}" Padding="10,2" Content="Run checks" />
                <Button Command="{Binding PostHealthCheckCommand}" Margin="8,0,0,0" Padding="10,2" Content="Run and post to Discord" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding HealthSummary}" />
            </StackPanel>
            <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding HealthRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                            <TextBlock Width="46" FontWeight="SemiBold" Text="{Binding Level}">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding Color}" />
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock Width="130" Text="{Binding Name}" />
                            <TextBlock Opacity="0.8" TextWrapping="Wrap" MaxWidth="700" Text="{Binding Detail}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Style="{StaticResource Row}" Margin="0,6,0,2">
                <TextBlock Style="{StaticResource Lbl}" Text="Spare disk space" />
                <TextBox Width="60" VerticalAlignment="Center" Text="{Binding Settings.MinFreeGb}"
                         ToolTip="Wanted on top of tonight's estimated frames." />
                <TextBlock Style="{StaticResource Unit}" Text="GB on top of tonight's frames" />
            </StackPanel>
            <StackPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource Lbl}" Text="Check that Dropbox is running" />
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding Settings.CheckDropbox}" />
            </StackPanel>

            <!-- ===== plans ===== -->
            <TextBlock Style="{StaticResource Head}" Text="Plans (Load Plan)" />
            <StackPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource Lbl}" Text="Plans folder" />
                <TextBox Width="420" VerticalAlignment="Center" Text="{Binding Settings.PlansDirectory}"
                         ToolTip="Dropbox folder the bot / dashboard write *.plan.json into." />
            </StackPanel>
            <StackPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource Lbl}" Text="Night rolls over at" />
                <TextBox Width="60" VerticalAlignment="Center" Text="{Binding Settings.RolloverHour}"
                         ToolTip="Before this local hour it is still last evening's night." />
                <TextBlock Style="{StaticResource Unit}" Text="h (local)" />
            </StackPanel>
            <StackPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource Lbl}" Text="Wait for the plan to sync" />
                <TextBox Width="60" VerticalAlignment="Center" Text="{Binding Settings.WaitForPlanMinutes}" />
                <TextBlock Style="{StaticResource Unit}" Text="min, then fail" />
            </StackPanel>

            <!-- ===== calibration nights ===== -->
            <TextBlock Style="{StaticResource Head}" Text="Calibration nights (SkyShareAstro Session)" />
            <TextBlock Opacity="0.7" Margin="0,0,0,4" TextWrapping="Wrap"
                       Text="Before the calibration sequence the flat panel is normally off and disconnected. The session container can power it up, connect it, close its cover, then take the darks." />
            <StackPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource Lbl}" Text="Switch port powering the flat panel" />
                <ComboBox Width="220" IsEditable="True" VerticalAlignment="Center"
                          ItemsSource="{Binding SwitchPorts}" Text="{Binding Settings.FlatPanelSwitch, UpdateSourceTrigger=LostFocus}"
                          ToolTip="Leave empty if the panel isn't on a switch port." />
                <Button Margin="8,0,0,0" Padding="10,2" Command="{Binding RefreshSwitchPortsCommand}" Content="Refresh" />
                <TextBlock Style="{StaticResource Unit}" Text="{Binding SwitchPortsNote}" />
            </StackPanel>
            <StackPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource Lbl}" Text="Connect flat panel before calibration" />
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding Settings.ConnectFlatPanelForCalibration}"
                          ToolTip="Power the port on, connect the panel in N.I.N.A. and close its cover before the darks." />
            </StackPanel>
            <StackPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource Lbl}" Text="Disconnect flat panel once closed" />
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding Settings.DisconnectFlatPanelWhenClosed}" />
            </StackPanel>

            <!-- ===== targets ===== -->
            <TextBlock Style="{StaticResource Head}" Text="Targets" />
            <StackPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource Lbl}" Text="Stop a target below" />
                <TextBox Width="60" VerticalAlignment="Center" Text="{Binding Settings.MinAltitude}" />
                <TextBlock Style="{StaticResource Unit}" Text="° altitude" />
            </StackPanel>
            <StackPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource Lbl}" Text="Autofocus at the start of each target" />
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding Settings.AutofocusAtStart}" />
            </StackPanel>
            <StackPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource Lbl}" Text="Dither every" />
                <TextBox Width="60" VerticalAlignment="Center" Text="{Binding Settings.DitherEvery}" />
                <TextBlock Style="{StaticResource Unit}" Text="frames (fixed-count targets; 0 = off; cycle targets dither once per cycle)" />
            </StackPanel>
            <StackPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource Lbl}" Text="Re-center after drifting more than" />
                <TextBox Width="60" VerticalAlignment="Center" Text="{Binding Settings.CenterDriftThreshold}" />
                <TextBlock Style="{StaticResource Unit}" Text="arcmin" />
            </StackPanel>

            <!-- ===== night preview ===== -->
            <TextBlock Style="{StaticResource Head}" Text="Night preview (posted by Load Plan)" />
            <StackPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource Lbl}" Text="Post the night preview" />
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding Settings.SendNightPreview}"
                          ToolTip="Clear-sky estimate of tonight, posted to Discord with an altitude chart." />
                <TextBlock Margin="20,0,0,0" VerticalAlignment="Center" Text="with framing" />
                <CheckBox Margin="6,0,0,0" VerticalAlignment="Center" IsChecked="{Binding Settings.SendFramingPreview}"
                          ToolTip="Attach a sky-survey cutout of each target with the camera frame drawn at its rotation." />
            </StackPanel>
            <TextBlock Opacity="0.7" Margin="0,4,0,2" Text="Overheads for the estimate only (they don't change the sequence):" />
            <StackPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource Lbl}" Text="Slew, solve, center, rotate" />
                <TextBox Width="60" VerticalAlignment="Center" Text="{Binding Settings.SlewCenterMinutes}" />
                <TextBlock Style="{StaticResource Unit}" Text="min per target" />
            </StackPanel>
            <StackPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource Lbl}" Text="Autofocus run" />
                <TextBox Width="60" VerticalAlignment="Center" Text="{Binding Settings.AutofocusMinutes}" />
                <TextBlock Style="{StaticResource Unit}" Text="min, every" />
                <TextBox Width="60" VerticalAlignment="Center" Margin="6,0,0,0" Text="{Binding Settings.AutofocusEveryMinutes}"
                         ToolTip="How often your template's autofocus triggers fire on average. 0 = only at the start of each target." />
                <TextBlock Style="{StaticResource Unit}" Text="min (0 = only at target start)" />
            </StackPanel>
            <StackPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource Lbl}" Text="Dither and settle" />
                <TextBox Width="60" VerticalAlignment="Center" Text="{Binding Settings.DitherSeconds}" />
                <TextBlock Style="{StaticResource Unit}" Text="s" />
            </StackPanel>
            <StackPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource Lbl}" Text="Download and save" />
                <TextBox Width="60" VerticalAlignment="Center" Text="{Binding Settings.FrameOverheadSeconds}" />
                <TextBlock Style="{StaticResource Unit}" Text="s per frame" />
            </StackPanel>
            <StackPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource Lbl}" Text="Meridian flip" />
                <TextBox Width="60" VerticalAlignment="Center" Text="{Binding Settings.MeridianFlipMinutes}" />
                <TextBlock Style="{StaticResource Unit}" Text="min" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

